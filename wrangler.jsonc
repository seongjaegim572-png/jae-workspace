// Cloudflare 가 병원 홈페이지를 올릴 때 읽는 설정.
// projects/clinic-website/dist 폴더(공개용 파일)만 인터넷에 올린다.
// worker/index.js: www 주소 → www 없는 주소로 넘기기 (나머지는 정적 파일 그대로).
{
  "name": "mirae-clinic-site",
  "compatibility_date": "2026-11-01",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./projects/clinic-website/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
